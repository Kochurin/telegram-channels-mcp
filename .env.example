# Copy to ~/.telegram-channels-mcp/.env or pass these values in the MCP client config
# `telegram-channels-mcp login` fills the first two for you

# From https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: where the session file lives (default ~/.telegram-channels-mcp/session)
# TELEGRAM_SESSION_PATH=

# Optional: session string from `telegram-channels-mcp login --string`, used instead of the file
# TELEGRAM_SESSION_STRING=

# Optional: 1 hides publish_post and reply_comment completely
# TELEGRAM_READ_ONLY=1

# Optional: comma-separated channels where writing is allowed, by username or id
# TELEGRAM_WRITE_ALLOWLIST=mychannel,-1001234567890
